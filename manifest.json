{
  "manifest_version": 3,
  "name": "Amazon - My Personal UX",
  "short_name": "My Personal UX",
  "version": "5.0.0",
  "description": "Cleans up Amazon: hides sponsored clutter, warns about extra fees, and adds unit prices, seller badges and price history.",
  "author": "Sandeep Kiran (Mousy)",
  "homepage_url": "https://github.com/SandeeepKiran/My-Personal-UX-for-Amazon",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Amazon - My Personal UX",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/background.js",
    "scripts": ["src/background/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://www.amazon.in/*", "https://www.amazon.com/*"],
      "exclude_matches": [
        "https://www.amazon.in/ap/*", "https://www.amazon.com/ap/*",
        "https://www.amazon.in/ax/*", "https://www.amazon.com/ax/*",
        "https://www.amazon.in/gp/buy/*", "https://www.amazon.com/gp/buy/*",
        "https://www.amazon.in/checkout/*", "https://www.amazon.com/checkout/*"
      ],
      "js": [
        "src/shared/settings.js",
        "src/content/core.js",
        "src/content/search.js",
        "src/content/product.js",
        "src/content/cart.js",
        "src/content/cashback.js",
        "src/content/navbar.js",
        "src/content/panel.js",
        "src/content/main.js"
      ],
      "css": ["src/content/content.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "my-personal-ux-amazon@mousy",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
